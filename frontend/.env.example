# API base URL for the FastAPI backend.
VITE_API_URL=http://localhost:8000

# Demo mode.
#   false  LIVE  — every call goes to FastAPI. If the backend is down the UI
#                  shows "Backend disconnected"; the demo engine is NOT used.
#   true   DEMO  — every call is served by the in-browser demo dataset.
#                  Used for the offline / single-file build.
VITE_DEMO_MODE=false
